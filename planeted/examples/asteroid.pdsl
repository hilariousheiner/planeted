import "../lib/stdlib.pdsl" 

n1 = noise();

seedNoise(n1, "CLOUD");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);

setNoiseType(n1, NOISE_TYPE_VALUE);
setNoiseStyle(n1, NOISE_STYLE_PLAIN);
setNormalizeFBM(n1, true);
setNumberOfOctaves(n1, 8);
setLacunarity(n1, 1.0);
setExponent(n1, 1.0);

m = displace(m, n1, 0.5);
m = calculateNormals(m);

n2 = noise();

seedNoise(n2, "BETTY");

setNoiseType(n2, NOISE_TYPE_PERLIN);
setNoiseStyle(n2, NOISE_STYLE_RIDGE);
setNumberOfOctaves(n2, 2);
setStartFrequency(n2, 4);
setNormalizeFBM(n2, true);
setExponent(n2, 5.0);

m = displace(m, n2, 0.5);
m = calculateNormals(m);

n3 = noise();

setNoiseType(n3, NOISE_TYPE_WHITE);
setWhiteNoiseScale(n3, 1.0);
setNumberOfOctaves(n3, 1);

m = displace(m, n3, 0.25);

return m;