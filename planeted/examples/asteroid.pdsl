import "stdlib.pdsl" 

seedNoise("POTATO");

m = icosahedron("asteroid");
m = subdivide(m, 4);

setNoiseType(NOISE_TYPE_VALUE);
setNumberOfOctaves(4);
setLacunarity(1.0);

m = displace(m, 0.5);

setNoiseType(NOISE_TYPE_WHITE);
setNumberOfOctaves(2);
setLacunarity(2.0);

m = displace(m, 0.025);

return m;