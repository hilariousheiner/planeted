N = 0;
S = 1;
W = 2;
E = 3;
U = 4;
D = 5;

m = 
(
    [
		( 0,  0, 1), // N
		( 0,  0,-1), // S
		(-1,  0, 0), // W
		( 1,  0, 0), // E
		( 0,  1, 0), // U 
		( 0, -1, 0)  // D
	],
    [
		// top:
		(U, E, S),
		(U, N, E),
		(U, W, N),
		(U, S, W),
        
		// bottom:
		(D, S, E),
		(D, E, N),
		(D, N, W),
		(D, W, S)
    ]
);
return m;