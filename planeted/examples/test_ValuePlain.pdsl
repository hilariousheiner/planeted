import "stdlib.pdsl" 

seedNoise("11836-Eileen");

setNormalizeFBM(false);
setStartFrequency(1.0);
setLacunarity(1.5);
setNumberOfOctaves(6);
setExponent(2.0);

setNoiseType(NOISE_TYPE_VALUE);
setNoiseStyle(NOISE_STYLE_PLAIN);

noiseTest("test_ValuePlain3D");
noiseTest2D("test_ValuePlain2D");
noiseTest1D("test_ValuePlain1D");

return displace(subdivide(icosahedron("test_ValuePlain"), 4), 1.0);