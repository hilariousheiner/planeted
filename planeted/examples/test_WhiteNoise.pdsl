import "stdlib.pdsl" 

seedNoise("Diomedes-1437");

setNormalizeFBM(false);
setStartFrequency(1.0);
setLacunarity(1.0);
setNumberOfOctaves(1);
setExponent(1.0);

setWhiteNoiseScale(100.0);

setNoiseType(NOISE_TYPE_WHITE);
setNoiseStyle(NOISE_STYLE_PLAIN);

noiseTest("test_WhiteNoise3D");
noiseTest2D("test_WhiteNoise2D");
noiseTest1D("test_WhiteNoise1D");

return displace(load("icosphere2.pdsl"), 0.25);