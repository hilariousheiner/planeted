import "../lib/stdlib.pdsl" 

n = noise();

seedNoise(n, "Amphitrite-29");

setNormalizeFBM(n, false);
setStartFrequency(n, 1.0);
setLacunarity(n, 1.0);
setNumberOfOctaves(n, 6);
setExponent(n, 1.5);

setNoiseType(n, NOISE_TYPE_PERLIN);
setNoiseStyle(n, NOISE_STYLE_BILLOW);

noiseTest(n, "test_PerlinBillow3D");
noiseTest2D(n, "test_PerlinBillow2D");
noiseTest1D(n, "test_PerlinBillow1D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, n, 0.25);