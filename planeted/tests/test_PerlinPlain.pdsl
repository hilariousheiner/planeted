import "../lib/stdlib.pdsl" 

n = noise();

seedNoise(n, "11836-Eileen");

setNormalizeFBM(n, true);
setStartFrequency(n, 1.0);
setLacunarity(n, 2.0);
setNumberOfOctaves(n, 6);
setExponent(n, 1.0);

setNoiseType(n, NOISE_TYPE_PERLIN);
setNoiseStyle(n, NOISE_STYLE_PLAIN);

noiseTest(n, "test_PerlinPlain3D");
noiseTest2D(n, "test_PerlinPlain2D");
noiseTest1D(n, "test_PerlinPlain1D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, n, 0.25);