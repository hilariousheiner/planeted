import "../lib/stdlib.pdsl" 

n = noise(); 

seedNoise(n, "11836-Eileen");

setNormalizeFBM(n, false);
setStartFrequency(n, 1.0);
setLacunarity(n, 1.5);
setNumberOfOctaves(n, 6);
setExponent(n, 2.0);

setNoiseType(n, NOISE_TYPE_VALUE);
setNoiseStyle(n, NOISE_STYLE_PLAIN);

noiseTest(n, "test_ValuePlain3D");
noiseTest2D(n, "test_ValuePlain2D");
noiseTest1D(n, "test_ValuePlain1D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, n, 1.0);