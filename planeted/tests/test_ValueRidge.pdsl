import "../lib/stdlib.pdsl" 

seedNoise("BETTY");

setNormalizeFBM(false);
setStartFrequency(4.0);
setNumberOfOctaves(6);
setExponent(10.0);

setNoiseType(NOISE_TYPE_VALUE);
setNoiseStyle(NOISE_STYLE_RIDGE);

noiseTest("test_ValueRidge3D");
noiseTest2D("test_ValueRidge2D");
noiseTest1D("test_ValueRidge1D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, 0.05);