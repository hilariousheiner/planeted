import "../lib/stdlib.pdsl" 

n = noise();

seedNoise(n, "BETTY");

setNormalizeFBM(n, false);
setStartFrequency(n, 4.0);
setNumberOfOctaves(n, 6);
setExponent(n, 10.0);

setNoiseType(n, NOISE_TYPE_VALUE);
setNoiseStyle(n, NOISE_STYLE_RIDGE);

noiseTest(n, "test_ValueRidge3D");
noiseTest2D(n, "test_ValueRidge2D");
noiseTest1D(n, "test_ValueRidge1D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, n, 0.05);