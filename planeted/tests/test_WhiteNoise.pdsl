import "../lib/stdlib.pdsl" 

n = noise();

seedNoise(n, "Diomedes-1437");

setNormalizeFBM(n, false);
setStartFrequency(n, 1.0);
setLacunarity(n, 1.0);
setNumberOfOctaves(n, 1);
setExponent(n, 1.0);

setWhiteNoiseScale(n, 100.0);

setNoiseType(n, NOISE_TYPE_WHITE);
setNoiseStyle(n, NOISE_STYLE_PLAIN);

noiseTest(n, "test_WhiteNoise3D");
noiseTest2D(n, "test_WhiteNoise2D");
noiseTest1D(n, "test_WhiteNoise1D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, n, 0.25);